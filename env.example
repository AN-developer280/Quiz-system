# Copy this file to ".env" and fill in the values.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- AI quiz generation (required for teachers to generate quizzes) ---
# FREE: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative (paid): used only if GEMINI_API_KEY is empty
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Email ---
# Leave EMAIL_HOST empty in development: emails are printed in the terminal.
# For real emails (e.g. Gmail) use an App Password:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Quiz Portal <noreply@example.com>
